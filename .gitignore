# Generated by @sneat/build-info's `sneat-stamp-build-info` (the
# `stamp-build-info` Nx target, a dependency of datatug-app's build/serve
# targets) — this app's own real version/git hash/build timestamp. Neither
# is ever committed; see apps/datatug-app/README.md "Build info".
# build-info.generated.ts is the file actually stamped (an Angular
# fileReplacements swap-in for the committed placeholder build-info.ts —
# see apps/datatug-app/project.json), so the committed file is never
# touched and `git status` stays clean after a build/serve.
apps/datatug-app/src/build-info.generated.ts
# build-info.json is the curl-able JSON sibling, copied to the dist root.
apps/datatug-app/src/build-info.json
