{
  "name": "datatug-main",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/datatug/main/src",
  "prefix": "sneat",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/datatug/main/ng-package.json",
        "tsConfig": "libs/datatug/main/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/datatug/main/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "dependsOn": ["test-isolated"],
      "options": {
        "cwd": ".",
        "config": "libs/datatug/main/vite.config.mts"
      }
    },
    "test-isolated": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}-isolated"],
      "options": {
        "cwd": ".",
        "config": "libs/datatug/main/vite.isolated.config.mts"
      }
    },
    "test-focused": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": ".",
        "command": "vitest run --config libs/datatug/main/vite.focused.config.mts"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "outputs": [],
      "options": {
        "command": "tsc --noEmit --project libs/datatug/main/tsconfig.spec.json"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
