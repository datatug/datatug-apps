{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec-helper.ts",
    "src/**/test-setup.ts",
    "src/test-setup.ts",
    "src/**/*.test.ts"
  ],
  "include": ["src/**/*.ts"]
}
