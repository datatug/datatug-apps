  "queries": {
    "sales/chinook-sales-per-capita": {
      "id": "chinook-sales-per-capita",
      "title": "Chinook sales per capita by country",
      "purpose": "Which countries buy the most music relative to their population? Chinook invoices, country alias, World Bank population.",
      "dtql": "# Which countries buy the most music relative to their population?\n#\n#   Invoice (Chinook, BillingCountry is a name such as \"USA\")\n#     -> country_aliases (alias -> ISO country key)\n#        -> population_wb (World Bank SP.POP.TOTL, latest year)\n#\n# Three sources, one nested join, then grouped. No AI is involved: the same\n# document always returns the same rows. Totals are floating point: the exact\n# `money` policy is unavailable here for two separate reasons. It requires the\n# streaming plan (one flat join, no `orderBy`), and it rejects REAL inputs\n# (Chinook stores Total as REAL; money needs strings or whole minor units), so\n# a flat plan alone would not fix it. Consumers should round for display.\nfrom:\n  database: chinook\n  name: Invoice\n  alias: i\n  joins:\n    - from:\n        database: geo\n        name: country_aliases\n        alias: a\n        joins:\n          - from: {database: geo, name: population_wb, alias: p}\n            on: [{left: {field: country, source: a}, op: '==', right: {field: country, source: p}}]\n      on: [{left: {field: BillingCountry, source: i}, op: '==', right: {field: alias, source: a}}]\ngroupBy: [{field: alias, source: a}, {field: year, source: p}, {field: population, source: p}]\ncolumns:\n  - {field: alias, source: a, as: country}\n  - {aggregate: {function: sum, args: [{field: Total, source: i}]}, as: totalSales}\n  - {field: population, source: p, as: population}\n  - {field: year, source: p, as: populationYear}\n  - {binary: {op: '*', left: {binary: {op: '/', left: {aggregate: {function: sum, args: [{field: Total, source: i}]}}, right: {field: population, source: p}}}, right: {value: 1000000}}, as: salesPerMillion}\norderBy:\n  - binary: {op: '*', left: {binary: {op: '/', left: {aggregate: {function: sum, args: [{field: Total, source: i}]}}, right: {field: population, source: p}}}, right: {value: 1000000}}\n    desc: true\n",
      "federation": {
        "ovdbBaseUrl": "http://127.0.0.1:50501",
