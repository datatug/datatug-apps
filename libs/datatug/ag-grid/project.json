{
  "name": "datatug-ag-grid",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/datatug/ag-grid/src",
  "prefix": "datatug",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/datatug/ag-grid/ng-package.json",
        "tsConfig": "libs/datatug/ag-grid/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/datatug/ag-grid/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/**/*.{ts,html}",
        "{workspaceRoot}/libs/**/*.{ts,html}",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "options": {
        "cwd": ".",
        "config": "libs/datatug/ag-grid/vite.config.mts"
      }
    }
  }
}
