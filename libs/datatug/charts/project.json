{
  "name": "datatug-charts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/datatug/charts/src",
  "prefix": "sneat",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/datatug/charts/ng-package.json",
        "tsConfig": "libs/datatug/charts/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/datatug/charts/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "options": {
        "cwd": ".",
        "config": "libs/datatug/charts/vite.config.mts"
      }
    }
  }
}
