{
  "id": "sales-overview",
  "title": "Sales overview",
  "folder": "~/dashboards",
  "tags": ["sales", "demo"],
  "userIds": ["u1"],
  "access": "protected",
  "parameters": [
    {
      "id": "year",
      "type": "integer",
      "title": "Year",
      "isRequired": true,
      "defaultValue": 2026
    },
    {
      "id": "region",
      "type": "string",
      "isMultiValue": true
    }
  ],
  "requiredParams": [["year"], ["region", "year"]],
  "rows": [
    {
      "minHeight": "240px",
      "cards": [
        {
          "id": "card-revenue",
          "title": "Revenue by month",
          "cols": 6,
          "widget": {
            "name": "SQL",
            "data": {
              "title": "Revenue by month",
              "parameters": [
                {
                  "id": "year",
                  "type": "integer",
                  "title": "Year",
                  "isRequired": true,
                  "defaultValue": 2026
                }
              ],
              "sql": {
                "queryId": "q-revenue-by-month",
                "parameters": [{ "id": "year", "boardParameterId": "year" }]
              }
            }
          }
        },
        {
          "id": "card-breakdown",
          "title": "Breakdown",
          "cols": 6,
          "widget": {
            "name": "tabs",
            "data": {
              "title": "Breakdown",
              "tabs": [
                {
                  "title": "By region",
                  "widget": {
                    "name": "SQL",
                    "data": {
                      "sql": {
                        "queryId": "q-revenue-by-region",
                        "parameters": [{ "id": "region", "value": "EMEA" }]
                      }
                    }
                  }
                },
                {
                  "title": "Live feed",
                  "widget": {
                    "name": "HTTP",
                    "data": {
                      "request": {
                        "method": "GET",
                        "url": "https://example.com/api/sales/live",
                        "protocol": "https",
                        "headers": [
                          { "name": "Accept", "value": "application/json" }
                        ],
                        "timeoutThresholdMs": 5000
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "maxHeight": "480px",
      "cards": [
        {
          "id": "card-webhook",
          "title": "Webhook trigger",
          "widget": {
            "name": "HTTP",
            "data": {
              "title": "Webhook trigger",
              "parameters": [
                {
                  "id": "customerId",
                  "type": "string",
                  "isRequired": true,
                  "meta": { "entity": "Customer", "field": "ID" },
                  "lookup": {
                    "db": "sales",
                    "sql": "SELECT id FROM customers",
                    "keyFields": ["id"]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "https://example.com/api/hooks/notify",
                "content": "{\"customerId\":\"@customerId\"}"
              }
            }
          }
        }
      ]
    }
  ]
}
