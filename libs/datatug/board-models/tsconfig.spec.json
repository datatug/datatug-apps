{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "module": "esnext",
    "target": "es2016",
    "types": ["node", "vitest/globals", "vitest/importMeta", "vite/client", "vitest"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/lib/__fixtures__/**/*.json"
  ]
}
