{
  "name": "datatug-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/datatug-app/src",
  "prefix": "sneat",
  "targets": {
    "e2e-meanings": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-app-meanings-e2e"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.meanings.config.ts --forbid-only"
      }
    },
    "typecheck-showcase-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "outputs": [],
      "options": {
        "command": "tsc --noEmit --project apps/datatug-app/tsconfig.showcase-e2e.json"
      }
    },
    "stamp-build-info": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/datatug-app/src/build-info.generated.ts",
        "{workspaceRoot}/apps/datatug-app/src/build-info.json"
      ],
      "cache": false,
      "options": {
        "commands": [
          "cp apps/datatug-app/src/build-info.ts apps/datatug-app/src/build-info.generated.ts",
          "sneat-stamp-build-info --ts apps/datatug-app/src/build-info.generated.ts --json apps/datatug-app/src/build-info.json"
        ],
        "parallel": false
      }
    },
    "stamp-ag-grid-license": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/datatug-app/src/ag-grid-license.generated.ts"
      ],
      "cache": false,
      "options": {
        "command": "node tools/stamp-ag-grid-license.mjs"
      }
    },
    "check-build-info": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "sneat-stamp-build-info --check --ts apps/datatug-app/src/build-info.ts"
      }
    },
    "prepare-recordsetcompare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 tools/recordsetcompare/consume.py prepare",
        "cwd": "."
      }
    },
    "verify-recordsetcompare-dist": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "python3 tools/recordsetcompare/consume.py verify-dist",
        "cwd": "."
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": [
        "stamp-build-info",
        "stamp-ag-grid-license",
        "prepare-recordsetcompare"
      ],
      "inputs": ["production", "{workspaceRoot}/tools/recordsetcompare/**/*"],
      "cache": false,
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/datatug-app",
        "index": "apps/datatug-app/src/index.html",
        "browser": "apps/datatug-app/src/main.ts",
        "polyfills": [],
        "allowedCommonJsDependencies": ["qrcode", "sql.js"],
        "tsConfig": "apps/datatug-app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/datatug-app/src/favicon.ico",
          "apps/datatug-app/src/assets",
          {
            "glob": "sql-wasm.wasm",
            "input": "node_modules/sql.js/dist",
            "output": "./assets"
          },
          {
            "glob": "sqlite3.wasm",
            "input": "node_modules/@sqlite.org/sqlite-wasm/dist",
            "output": "."
          },
          {
            "glob": "**/*.svg",
            "input": "node_modules/ionicons/dist/ionicons/svg",
            "output": "./svg"
          },
          {
            "glob": "build-info.json",
            "input": "apps/datatug-app/src",
            "output": "."
          }
        ],
        "styles": ["apps/datatug-app/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2.5mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "6.5kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/datatug-app/src/environments/environment.ts",
              "with": "apps/datatug-app/src/environments/environment.prod.ts"
            },
            {
              "replace": "apps/datatug-app/src/build-info.ts",
              "with": "apps/datatug-app/src/build-info.generated.ts"
            },
            {
              "replace": "apps/datatug-app/src/ag-grid-license.ts",
              "with": "apps/datatug-app/src/ag-grid-license.generated.ts"
            }
          ],
          "outputHashing": "all",
          "sourceMap": {
            "scripts": true,
            "hidden": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/datatug-app/src/build-info.ts",
              "with": "apps/datatug-app/src/build-info.generated.ts"
            },
            {
              "replace": "apps/datatug-app/src/ag-grid-license.ts",
              "with": "apps/datatug-app/src/ag-grid-license.generated.ts"
            }
          ]
        },
        "sso-e2e": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/datatug-app/src/environments/environment.ts",
              "with": "apps/datatug-app/src/environments/environment.sso-e2e.ts"
            },
            {
              "replace": "apps/datatug-app/src/build-info.ts",
              "with": "apps/datatug-app/src/build-info.generated.ts"
            },
            {
              "replace": "apps/datatug-app/src/ag-grid-license.ts",
              "with": "apps/datatug-app/src/ag-grid-license.generated.ts"
            }
          ]
        },
        "business-preview": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/datatug-app/src/environments/environment.ts",
              "with": "apps/datatug-app/src/environments/environment.business-preview.ts"
            },
            {
              "replace": "apps/datatug-app/src/build-info.ts",
              "with": "apps/datatug-app/src/build-info.generated.ts"
            },
            {
              "replace": "apps/datatug-app/src/ag-grid-license.ts",
              "with": "apps/datatug-app/src/ag-grid-license.generated.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "dependsOn": [
        "stamp-build-info",
        "stamp-ag-grid-license",
        "prepare-recordsetcompare"
      ],
      "defaultConfiguration": "development",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "datatug-app:build:production"
        },
        "development": {
          "buildTarget": "datatug-app:build:development",
          "host": "127.0.0.1",
          "allowedHosts": ["datatug.localhost"],
          "proxyConfig": "tools/public-ovdb-proxy.cjs"
        },
        "sso-e2e": {
          "buildTarget": "datatug-app:build:sso-e2e"
        },
        "business-preview": {
          "buildTarget": "datatug-app:build:business-preview",
          "port": 18782,
          "proxyConfig": "tools/public-ovdb-proxy.cjs"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "datatug-app:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-app-e2e"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.config.ts"
      }
    },
    "e2e-agent-links": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-app-agent-links-e2e"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.agent-links.config.ts --forbid-only"
      }
    },
    "e2e-query-mobile": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/apps/datatug-query-mobile/report",
        "{workspaceRoot}/coverage/apps/datatug-query-mobile/results"
      ],
      "cache": false,
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.query-mobile.config.ts --forbid-only"
      }
    },
    "e2e-sso": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-app-sso-e2e"],
      "options": {
        "command": "pnpm e2e:sso"
      }
    },
    "e2e-demo-handoff": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-app-demo-handoff-e2e"],
      "options": {
        "command": "pnpm e2e:demo-handoff"
      }
    },
    "e2e-demo-sqlite": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-app-demo-sqlite-e2e"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.demo-sqlite.config.ts --forbid-only"
      }
    },
    "e2e-demo-sqlite-adventureworks": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/coverage/apps/datatug-app-demo-sqlite-adventureworks-e2e"
      ],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.demo-sqlite-adventureworks.config.ts --forbid-only"
      }
    },
    "e2e-demo-postgresql": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/coverage/apps/datatug-app-demo-postgresql-e2e"
      ],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.demo-postgresql.config.ts --forbid-only"
      }
    },
    "e2e-error-dialog": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-app-error-dialog-e2e"],
      "options": {
        "command": "pnpm e2e:error-dialog"
      }
    },
    "e2e-checkout-provider": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-checkout-provider"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.checkout-provider.config.ts --forbid-only"
      }
    },
    "e2e-context-bag-provider": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-context-bag-provider"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.context-bag-provider.config.ts --forbid-only"
      }
    },
    "e2e-business-preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-business-preview"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.business-preview.config.ts --forbid-only"
      }
    },
    "e2e-checkout": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-checkout"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.checkout.config.ts --forbid-only"
      }
    },
    "e2e-cloud-logs": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-cloud-logs"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.cloud-logs.config.ts --forbid-only"
      }
    },
    "e2e-hosted-incidents": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-hosted-incidents"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.hosted-incidents.config.ts --forbid-only"
      }
    },
    "e2e-showcase-independent": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "stamp-build-info",
        "stamp-ag-grid-license",
        "prepare-recordsetcompare"
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/datatug-showcase-exploration"],
      "options": {
        "command": "playwright test -c apps/datatug-app/playwright.showcase-exploration.config.ts showcase-independent-sources.spec.ts --forbid-only"
      }
    },
    "test": {
      "options": {
        "cwd": ".",
        "config": "apps/datatug-app/vite.config.mts"
      }
    }
  }
}
