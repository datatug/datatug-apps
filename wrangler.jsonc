{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datatug-apps",
  "compatibility_date": "2026-06-08",
  "main": "./apps/datatug-app/worker/project-shell.mjs",
  "routes": [
    {
      "pattern": "datatug.app",
      "custom_domain": true
    },
    {
      "pattern": "app.incidentius.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/apps/datatug-app/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/project/*"]
  }
}
