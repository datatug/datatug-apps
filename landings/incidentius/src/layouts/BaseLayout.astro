---
import '../styles/global.css';
import SharedLayout from '@sneat/astro/layouts/BaseLayout.astro';
import type { SiteChrome, SiteMeta } from '@sneat/astro/config';
import { i18n } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  localeIndependent?: boolean;
}

const {
  title = 'Incidentius — Turn incident evidence into a defensible resolution',
  description = 'Investigate incidents with evidence, executable queries, hypotheses, comparisons, checks, metrics and a resolution record that preserves how the conclusion was reached.',
  noindex = false,
  localeIndependent = false,
} = Astro.props;

const siteDescription =
  'Incidentius helps teams investigate incidents from evidence and preserve a defensible resolution record.';

const site: SiteMeta = {
  name: 'Incidentius',
  url: 'https://incidentius.com',
  description: siteDescription,
  favicon: '/favicon.svg',
  themeColor: '#08141f',
  ogImageDefault: '/og-card.svg',
};

const chrome: SiteChrome = {
  brand: 'Incidentius',
  nav: [
    { href: '#method', label: 'Method' },
    { href: '#record', label: 'Resolution record' },
    { href: '#datatug', label: 'DataTug' },
  ],
  cta: {
    href: 'https://app.incidentius.com',
    label: 'Open Incidentius',
    labelShort: 'Open app',
  },
  footer: {
    tagline: 'Incident investigations built from evidence, not hindsight.',
    groups: [
      {
        title: 'Investigate',
        links: [
          { href: '#method', label: 'The method' },
          { href: '#record', label: 'Resolution records' },
        ],
      },
      {
        title: 'DataTug',
        links: [
          { href: 'https://datatug.app', label: 'DataTug website', external: true },
          { href: 'https://github.com/datatug', label: 'Open-source projects', external: true },
        ],
      },
    ],
    owner: 'Incidentius',
    ecosystemHref: 'https://datatug.app',
    ecosystemLabel: 'An incident-investigation capability of DataTug',
  },
  a11y: {
    skipToContent: 'Skip to content',
    brandHome: 'Incidentius home',
    primaryNav: 'Primary navigation',
  },
};
---

<SharedLayout
  i18n={i18n}
  site={site}
  chrome={chrome}
  locale="en"
  title={title}
  description={description}
  siteDescription={siteDescription}
  ogImage="/og-card.svg"
  noindex={noindex}
  localeIndependent={localeIndependent}
  langSwitcher={false}
>
  <Fragment slot="head">
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&amp;family=Manrope:wght@400;500;600;700;800&amp;display=swap"
      rel="stylesheet"
    />
    <script is:inline id="incidentius-analytics-consent">
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      var GA_ID = "G-3YFSWSX4T2";
      var gaStarted = false;
      function gaStartAnalytics() {
        if (gaStarted) return;
        gaStarted = true;
        gtag("consent", "default", { analytics_storage: "granted", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied" });
        gtag("js", new Date());
        gtag("config", GA_ID, { allow_google_signals: false, allow_ad_personalization_signals: false, page_location: location.origin + location.pathname });
        var script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
        document.head.appendChild(script);
      }
      function gaSetConsent(value) {
        try { localStorage.setItem("ga-consent", value); } catch (_) {}
        if (value === "granted") gaStartAnalytics();
        var banner = document.getElementById("ga-consent-banner");
        if (banner) banner.remove();
      }
      function gaInitializeConsent() {
        var saved;
        try { saved = localStorage.getItem("ga-consent"); } catch (_) {}
        if (saved === "granted") { gaStartAnalytics(); return; }
        if (saved === "denied" || document.getElementById("ga-consent-banner")) return;
        var wrap = document.createElement("div");
        wrap.id = "ga-consent-banner";
        wrap.setAttribute("role", "dialog");
        wrap.setAttribute("aria-label", "Cookie consent");
        wrap.innerHTML = "<p>May we use analytics cookies to measure site traffic? Analytics stays off until you accept.</p>" +
          '<div class="ga-consent-actions"><button type="button" id="ga-decline">Decline</button><button type="button" id="ga-accept">Accept</button></div>';
        document.body.appendChild(wrap);
        document.getElementById("ga-accept").addEventListener("click", function () { gaSetConsent("granted"); });
        document.getElementById("ga-decline").addEventListener("click", function () { gaSetConsent("denied"); });
      }
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", gaInitializeConsent, { once: true });
      else gaInitializeConsent();
    </script>
    <style is:global>
      #ga-consent-banner { position: fixed; left: 1rem; right: 1rem; bottom: 1rem; z-index: 2147483647; max-width: 520px; margin: 0 auto; background: #1c1f26; color: #e6e6e6; border: 1px solid #2c3038; border-radius: 12px; padding: 1rem 1.1rem; box-shadow: 0 6px 24px rgba(0,0,0,.3); font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
      #ga-consent-banner p { margin: 0 0 .7rem; }
      #ga-consent-banner .ga-consent-actions { display: flex; gap: .5rem; justify-content: flex-end; }
      #ga-consent-banner button { cursor: pointer; border-radius: 8px; padding: .4rem .9rem; font-size: 14px; border: 1px solid #3a3f4b; background: #262a32; color: #e6e6e6; }
      #ga-consent-banner button#ga-accept { background: #2f6f43; border-color: #2f6f43; color: #fff; }
    </style>
  </Fragment>
  <slot />
</SharedLayout>
