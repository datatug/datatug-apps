---
import BaseLayout from '../layouts/BaseLayout.astro';

const method = [
  {
    number: '01',
    title: 'Preserve the evidence',
    text: 'Keep the relevant observations, source context and supporting material attached to the investigation instead of scattering them across chat and tickets.',
  },
  {
    number: '02',
    title: 'Run the question',
    text: 'Turn a hunch into an executable query. Save the inputs and the query that produced each result so the path can be repeated and challenged.',
  },
  {
    number: '03',
    title: 'Compare hypotheses',
    text: 'State competing explanations, then use comparisons, checks and metrics to show which evidence supports or weakens each one.',
  },
  {
    number: '04',
    title: 'Record the resolution',
    text: 'Close with the conclusion, the checks that justify it and the evidence that remains relevant for the next investigation.',
  },
];

const record = [
  ['Evidence', 'What was observed, and where it came from'],
  ['Queries', 'The executable path from question to result'],
  ['Hypotheses', 'Competing explanations kept explicit'],
  ['Comparisons', 'Differences that separate one explanation from another'],
  ['Checks & metrics', 'Signals that can confirm or challenge the conclusion'],
  ['Resolution', 'What was decided, why, and what should be watched next'],
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Incident investigation, made executable</p>
        <h1>Move from <span>“what happened?”</span> to a resolution you can defend.</h1>
        <p class="lede">
          Incidentius keeps evidence, executable queries, hypotheses, comparisons,
          checks and metrics in one investigation record — so a conclusion carries
          the path that produced it.
        </p>
        <div class="actions">
          <a class="button primary" href="https://app.incidentius.com">
            Open Incidentius
          </a>
          <a class="button secondary" href="#method">See the investigation method</a>
        </div>
        <p class="availability">
          Use the dedicated Incidentius workspace at app.incidentius.com.
        </p>
      </div>

      <div class="investigation-map" aria-label="An investigation record connecting evidence to a resolution">
        <div class="map-head">
          <span>Investigation record</span>
          <span class="status"><i></i> Evidence linked</span>
        </div>
        <div class="map-flow">
          <div class="node evidence">
            <span class="node-kind">Inputs</span>
            <strong>Evidence</strong>
            <small>Observations · source context</small>
          </div>
          <div class="connector" aria-hidden="true"><span></span></div>
          <div class="node query">
            <span class="node-kind">Executable</span>
            <strong>Query + check</strong>
            <small>Parameters · result · metric</small>
          </div>
          <div class="branch" aria-hidden="true"><span></span><span></span></div>
          <div class="hypotheses">
            <div class="node compact"><span>A</span><strong>Hypothesis</strong></div>
            <div class="node compact muted"><span>B</span><strong>Alternative</strong></div>
          </div>
          <div class="comparison">
            <span class="node-kind">Discriminating evidence</span>
            <strong>Comparison</strong>
          </div>
          <div class="resolution">
            <span class="resolution-mark">✓</span>
            <div><span class="node-kind">Decision trail</span><strong>Resolution record</strong></div>
          </div>
        </div>
        <p class="diagram-note">Conceptual model — not a product screenshot</p>
      </div>
    </div>
  </section>

  <section class="principle">
    <div class="container">
      <p class="eyebrow">The operating principle</p>
      <h2>An incident is not a conclusion. It is a trail of evidence that should remain inspectable.</h2>
      <p>
        Incidentius is an incident-investigation capability of DataTug. It treats
        queries and checks as part of the record, preserving how the team moved
        from observations to a resolution without turning the investigation into
        a static postmortem document.
      </p>
    </div>
  </section>

  <section id="method" class="method-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">A repeatable method</p>
        <h2>Make every inference earn its place.</h2>
      </div>
      <div class="method-list">
        {method.map((step) => (
          <article class="method-step">
            <span class="step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="record" class="record-section">
    <div class="container record-grid">
      <div class="record-copy">
        <p class="eyebrow">One durable resolution record</p>
        <h2>Keep the reasoning with the result.</h2>
        <p>
          A resolution record is more than a timeline. It preserves the evidence,
          the questions that were run, the alternatives considered and the checks
          that support the final conclusion.
        </p>
        <p>
          When the same symptom appears again, the previous investigation is a
          starting point you can execute and reassess — not folklore to retell.
        </p>
      </div>
      <dl class="record-list">
        {record.map(([term, detail]) => (
          <div>
            <dt>{term}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="datatug" class="datatug-section">
    <div class="container datatug-grid">
      <div>
        <p class="eyebrow">Built as a DataTug capability</p>
        <h2>The investigation stays close to executable knowledge.</h2>
      </div>
      <div>
        <p>
          DataTug connects reusable queries, data context and checks. Incidentius
          applies that foundation to incident investigation, giving evidence and
          hypotheses a direct relationship to the queries that test them.
        </p>
        <a class="text-link" href="https://datatug.app">Explore DataTug <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-grid">
      <div>
        <p class="eyebrow">Follow the evidence</p>
        <h2>Build the record while you investigate.</h2>
      </div>
      <div>
        <p>Continue the investigation in the dedicated Incidentius app.</p>
        <a class="button primary" href="https://app.incidentius.com">
          Open Incidentius
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(5rem, 10vw, 9rem) 0 clamp(4rem, 8vw, 7rem);
  }
  .hero::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(120, 146, 165, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(120, 146, 165, 0.07) 1px, transparent 1px);
    background-size: 48px 48px;
    content: '';
    mask-image: linear-gradient(to bottom, black, transparent 82%);
    pointer-events: none;
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: clamp(3rem, 7vw, 7rem); }
  h1 { max-width: 760px; margin-bottom: 1.6rem; font-size: clamp(3.4rem, 6.6vw, 6.8rem); font-weight: 700; line-height: .91; }
  h1 span { color: var(--color-accent); }
  .lede { max-width: 640px; color: var(--color-text-muted); font-size: clamp(1.08rem, 2vw, 1.3rem); line-height: 1.55; }
  .actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; }
  .availability { margin: .9rem 0 0; color: var(--color-text-faint); font-size: .82rem; }

  .investigation-map { padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 28px; background: rgba(11, 26, 39, .88); box-shadow: var(--shadow); }
  .map-head { display: flex; justify-content: space-between; gap: 1rem; padding: .2rem .3rem 1rem; color: var(--color-text-muted); font-family: var(--font-mono); font-size: .69rem; letter-spacing: .08em; text-transform: uppercase; }
  .status { display: flex; align-items: center; gap: .4rem; }
  .status i { width: 7px; height: 7px; border-radius: 50%; background: #5eead4; box-shadow: 0 0 14px rgba(94, 234, 212, .8); }
  .map-flow { padding: 1.2rem; border-radius: 20px; background: #0e2130; }
  .node, .comparison, .resolution { border: 1px solid var(--color-border); border-radius: 15px; background: #13293a; }
  .node { display: grid; padding: 1rem; }
  .node strong, .comparison strong, .resolution strong { font-size: 1rem; }
  .node small { color: var(--color-text-muted); }
  .node-kind { color: #5eead4; font-family: var(--font-mono); font-size: .63rem; letter-spacing: .11em; text-transform: uppercase; }
  .connector { display: grid; height: 30px; place-items: center; }
  .connector span { width: 1px; height: 100%; background: var(--color-border); }
  .branch { display: flex; height: 28px; justify-content: space-around; }
  .branch span { width: 36%; border-top: 1px solid var(--color-border); border-right: 1px solid var(--color-border); }
  .branch span:last-child { border-right: 0; border-left: 1px solid var(--color-border); }
  .hypotheses { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  .node.compact { grid-template-columns: auto 1fr; align-items: center; gap: .75rem; padding: .8rem; }
  .node.compact > span { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 50%; background: #1c4a55; color: #8ff5e6; font-family: var(--font-mono); font-size: .75rem; }
  .node.compact.muted { opacity: .65; }
  .comparison { margin-top: .7rem; padding: .85rem; border-style: dashed; text-align: center; }
  .comparison span, .comparison strong { display: block; }
  .resolution { display: flex; align-items: center; gap: .9rem; margin-top: .7rem; padding: 1rem; border-color: rgba(255, 181, 71, .6); background: var(--color-accent-soft); }
  .resolution strong { display: block; }
  .resolution-mark { display: grid; width: 34px; height: 34px; flex: 0 0 auto; place-items: center; border-radius: 50%; background: var(--color-accent); color: var(--color-accent-text); font-weight: 900; }
  .diagram-note { margin: .8rem .2rem 0; color: var(--color-text-faint); font-size: .7rem; text-align: right; }

  .principle { padding: clamp(4.5rem, 8vw, 8rem) 0; border-block: 1px solid var(--color-border); background: var(--color-bg-2); text-align: center; }
  .principle h2 { max-width: 930px; margin: 0 auto 1.6rem; font-size: clamp(2.5rem, 5vw, 4.7rem); }
  .principle > .container > p:last-child { max-width: 730px; margin: 0 auto; color: var(--color-text-muted); font-size: 1.05rem; }

  .method-section, .record-section, .datatug-section, .final-cta { padding: clamp(4.5rem, 8vw, 8rem) 0; scroll-margin-top: 4rem; }
  .section-heading { display: grid; grid-template-columns: .55fr 1.45fr; gap: 2rem; margin-bottom: 3rem; }
  .section-heading h2 { max-width: 750px; margin: 0; font-size: clamp(2.7rem, 5vw, 4.8rem); }
  .method-list { border-top: 1px solid var(--color-border); }
  .method-step { display: grid; grid-template-columns: 70px .7fr 1.3fr; gap: 2rem; padding: 2.1rem 0; border-bottom: 1px solid var(--color-border); }
  .step-number { color: var(--color-accent); font-family: var(--font-mono); }
  .method-step h3 { margin: 0; font-size: 1.35rem; }
  .method-step p { max-width: 620px; margin: 0; color: var(--color-text-muted); }

  .record-section { background: #e9eef1; color: #10202d; }
  .record-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .record-copy { position: sticky; top: 7rem; }
  .record-copy .eyebrow { color: #8b5410; }
  .record-copy h2 { font-size: clamp(2.8rem, 5vw, 4.7rem); }
  .record-copy p { color: #445866; }
  .record-list { margin: 0; border-top: 1px solid #b8c5cd; }
  .record-list div { display: grid; grid-template-columns: .65fr 1.35fr; gap: 1.5rem; padding: 1.35rem 0; border-bottom: 1px solid #b8c5cd; }
  .record-list dt { font-weight: 800; }
  .record-list dd { margin: 0; color: #445866; }

  .datatug-section { background: var(--color-bg-2); }
  .datatug-grid, .final-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 8vw, 8rem); }
  .datatug-section h2, .final-cta h2 { margin: 0; font-size: clamp(2.5rem, 4vw, 4rem); }
  .datatug-section p:not(.eyebrow), .final-cta p { color: var(--color-text-muted); font-size: 1.08rem; }
  .text-link { color: #7debdc; font-weight: 800; text-underline-offset: 5px; }

  .final-cta { border-top: 1px solid var(--color-border); }
  .final-grid { align-items: end; }

  @media (max-width: 860px) {
    .hero-grid, .record-grid, .datatug-grid, .final-grid { grid-template-columns: 1fr; }
    .hero { padding-top: 5rem; }
    .investigation-map { max-width: 620px; }
    .record-copy { position: static; }
    .section-heading { grid-template-columns: 1fr; gap: .8rem; }
    .method-step { grid-template-columns: 48px 1fr; gap: 1rem; }
    .method-step p { grid-column: 2; }
  }

  @media (max-width: 520px) {
    h1 { font-size: 3.15rem; }
    .hypotheses { grid-template-columns: 1fr; }
    .record-list div { grid-template-columns: 1fr; gap: .35rem; }
    .actions .button { width: 100%; }
  }
</style>
