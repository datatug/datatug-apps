---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, pageUrl, type Locale } from '../copy';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale].home;
const dataTugHome = locale === 'ru' ? 'https://datatug.app/ru/' : 'https://datatug.app/';
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
  <section class="home-hero">
    <div class="container home-grid">
      <div class="home-copy">
        <span class="kicker"><i aria-hidden="true"></i> {t.kicker}</span>
        <p class="eyebrow" style="color:#f3a18a; margin-top:1.5rem">{t.eyebrow}</p>
        <h1>{t.heading}<br /><span>{t.headingAccent}</span></h1>
        <p class="lede">{t.lede}</p>
        <div class="actions">
          <a class="button primary" href={pageUrl(locale, 'investigations')}>{t.exploreMethod} <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href={pageUrl(locale, 'platform')}>{t.foundation}</a>
        </div>
      </div>
      <figure class="hero-art">
        <img src="/illustrations/incidentius-harbor-800.webp" srcset="/illustrations/incidentius-harbor-800.webp 800w, /illustrations/incidentius-harbor.webp 1672w" sizes="(max-width: 900px) 100vw, 55vw" width="1672" height="941" alt={t.imageAlt} fetchpriority="high" />
        <figcaption class="art-caption"><span>{t.artLabel}</span><span>{t.artNote}</span></figcaption>
      </figure>
    </div>
  </section>

  <div class="development-band"><p><strong>{t.statusLead}</strong> {t.statusText}</p></div>

  <section class="home-intro"><div class="container intro-grid">
    <div><p class="eyebrow">{t.introEyebrow}</p><h2>{t.introHeading}</h2></div><p>{t.introText}</p>
  </div></section>

  <section class="page-links"><div class="container">
    <div class="page-links-head"><div><p class="eyebrow">{t.pagesEyebrow}</p><h2>{t.pagesHeading}</h2></div><p class="status-note">{t.pagesStatus}</p></div>
    <div class="page-grid">{t.pages.map((page) => <a class="page-card" href={pageUrl(locale, page.slug)}>
      <div class="page-card-top"><span class="page-card-number">{page.number} / 04</span><span class="card-arrow" aria-hidden="true">↗</span></div>
      <div><h3>{page.title}</h3><p>{page.text}</p></div>
    </a>)}</div>
  </div></section>

  <section class="foundation-band"><div class="container foundation-grid">
    <div><p class="eyebrow">{t.foundationEyebrow}</p><h2>{t.foundationHeading}</h2></div>
    <div><p>{t.foundationText}</p><div class="actions">
      <a class="button light" href={pageUrl(locale, 'platform')}>{t.foundationLink} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={dataTugHome}>{t.datatugLink} <span aria-hidden="true">↗</span></a>
    </div></div>
  </div></section>
</BaseLayout>
