---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, pageUrl, type Locale } from '../copy';
const { locale, slug } = Astro.props as { locale: Locale; slug: 'investigations'|'context'|'checks'|'platform' };
const t: any = copy[locale].pages[slug];
const links = ['investigations', 'context', 'checks', 'platform'] as const;
const isPlatform = slug === 'platform';
const isContext = slug === 'context';
const isChecks = slug === 'checks';
const dataTugHome = locale === 'ru' ? 'https://datatug.app/ru/' : 'https://datatug.app/';
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
  <section class="page-hero"><div class="container page-hero-inner">
    <span class="kicker"><i aria-hidden="true"></i> {locale === 'ru' ? 'Продукт в разработке' : 'Product in development'}</span>
    <p class="eyebrow" style="color:#f3a18a; margin-top:1.5rem">{t.eyebrow}</p>
    <h1>{t.heading}</h1><p class="lede">{t.lede}</p>
    <div class="actions">
      <a class="button primary" href={isPlatform ? dataTugHome : pageUrl(locale, slug === 'investigations' ? 'context' : 'investigations')}>{t.primaryLink} <span aria-hidden="true">↗</span></a>
      <a class="button secondary" href={isPlatform ? pageUrl(locale, 'investigations') : pageUrl(locale, isChecks ? 'context' : 'checks')}>{t.secondaryLink}</a>
    </div>
  </div></section>

  <section class="page-content"><div class="container">
    <div class="content-intro"><div><p class="eyebrow">{t.introEyebrow}</p><h2>{t.introHeading}</h2></div><p>{t.introText}</p></div>

    {t.steps && <div class="steps">{t.steps.map((step: string[], index: number) => <article class="step"><span class="step-num">0{index + 1}</span><h3>{step[0]}</h3><p>{step[1]}</p></article>)}</div>}

    {t.diagramNodes && <div class="concept-panel" aria-label={t.diagramTitle}>
      <div class="concept-head"><span>{t.diagramTitle}</span><span>{t.diagramStatus}</span></div>
      <div class="concept-flow">{t.diagramNodes.map((node: string[]) => <div class="concept-node"><small>{node[0]}</small><strong>{node[1]}</strong><p>{node[2]}</p></div>)}</div>
      <p class="concept-caption">{t.diagramCaption}</p>
    </div>}

    {t.cards && <div class={isContext ? 'split-section' : 'steps'}>{t.cards.map((card: string[], index: number) => <article class={isContext ? 'info-card' : 'step'}>
      {!isContext && <span class="step-num">{card[0]}</span>}{isContext && <p class="eyebrow">{card[0]}</p>}
      <h3>{card[1]}</h3><p>{card[2]}</p>{card[3] && <a class="text-link" href={index === 0 ? dataTugHome : pageUrl(locale, 'investigations')}>{card[3]} <span aria-hidden="true">↗</span></a>}
    </article>)}</div>}

    {isPlatform && <>
      <section class="detective-card"><p class="eyebrow">{t.detectiveEyebrow}</p><h2>{t.detectiveHeading}</h2><p>{t.detectiveText}</p></section>
      <div class="content-intro"><div><p class="eyebrow">{t.reuseEyebrow}</p><h2>{t.reuseHeading}</h2></div><p>{t.reuseText}</p></div>
      <div class="page-grid family-grid">{t.familyCards.map((card: string[]) => <a class="page-card" href={card[3]}><span class="eyebrow">{card[0]}</span><h3>{card[1]}</h3><p>{card[2]}</p></a>)}</div>
    </>}

    {t.example && <div class="example"><div><p class="eyebrow">{t.exampleEyebrow}</p><h3>{t.exampleTitle}</h3><p>{t.exampleIntro}</p></div>
      <div class="example-list">{t.example.map((item: string[]) => <div class="example-item"><strong>{item[0]}</strong><span>{item[1]}</span></div>)}</div>
    </div>}

    {t.closingCards && <div class="split-section">{t.closingCards.map((card: string[]) => <article class="info-card"><p class="eyebrow">{card[0]}</p><h3>{card[1]}</h3><p>{card[2]}</p></article>)}</div>}

    {isPlatform && <section class="foundation-band closing-band"><div class="container foundation-grid"><div><p class="eyebrow">{t.closingEyebrow}</p><h2>{t.closingHeading}</h2></div><div><p>{t.closingText}</p><a class="button light" href={dataTugHome}>{t.closingButton} <span aria-hidden="true">↗</span></a></div></div></section>}

    <nav class="related-links" aria-label={locale === 'ru' ? 'Связанные страницы' : 'Related pages'}>{links.filter((link) => link !== slug).map((link) => <a class="button light" href={pageUrl(locale, link)}>{t.links[links.indexOf(link)]} <span aria-hidden="true">↗</span></a>)}</nav>
  </div></section>
</BaseLayout>
