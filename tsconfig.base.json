{
  "extends": "./tsconfig.json",
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "incremental": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true,
    "paths": {
      "@datatug/board-models": ["./libs/datatug/board-models/src/public_api.ts"],
      "@datatug/project-address": ["./libs/datatug/project-address/src/public_api.ts"],
      "@datatug/product-profiles": ["./libs/datatug/product-profiles/src/public_api.ts"],
      "@sneat/datatug-main": ["./libs/datatug/main/src/public_api.ts"],
      "@sneat/datatug-semantic": ["./libs/datatug/semantic/src/public_api.ts"],
      "@sneat/datatug-semantic/fixtures/client-only-source-rights.json": ["./libs/datatug/semantic/src/contract/fixtures/client-only-source-rights.json"],
      "@sneat/core/testing": ["./libs/testing/src/test-setup.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
