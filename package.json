  "scripts": {
    "sentry:sourcemaps": "sentry-cli sourcemaps inject dist/apps/datatug-app/browser && sentry-cli sourcemaps upload --org sneat-eu --project datatug-app dist/apps/datatug-app/browser && find dist/apps/datatug-app/browser -name '*.js.map' -delete",
    "e2e:sso": "playwright test -c apps/datatug-app/playwright.sso.config.ts",
    "e2e:sso:keycloak": "SSO_E2E_OIDC_ISSUER=http://127.0.0.1:8088/realms/acme SSO_E2E_OIDC_CLIENT_ID=datatug SSO_E2E_OIDC_CLIENT_SECRET=keycloak-client-secret playwright test -c apps/datatug-app/playwright.sso-keycloak.config.ts",
    "e2e:error-dialog": "playwright test -c apps/datatug-app/playwright.error-dialog.config.ts",
    "e2e:demo-handoff": "playwright test -c apps/datatug-app/playwright.demo-handoff.config.ts",
    "check:zoneless": "node tools/check-zoneless-fields.mjs",
    "check:card-headers": "node tools/check-card-headers.mjs",
    "test:check-card-headers": "node --test tools/__tests__/check-card-headers.test.mjs",
    "test:check-zoneless-fields": "node --test tools/__tests__/check-zoneless-fields.test.mjs",
    "test:stamp-ag-grid-license": "node --test tools/__tests__/stamp-ag-grid-license.test.mjs",
    "test:wrangler-routes": "node --test scripts/wrangler-routes.test.mjs",
    "check:demo-sqlite-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-demo-sqlite-catalog.mjs",
    "check:demo-postgresql-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-demo-postgresql-catalog.mjs",
    "test:checkout-flow": "node --test tools/checkout-flow.test.mjs"
  },
