{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // demo.datatug.app -> https://datatug.app/demo (index.mjs). Deployed by .github/workflows/deploy-demo-redirect.yml.
  // The custom domain creates its own DNS record for demo.datatug.app (no record may exist before).
  "name": "datatug-demo-redirect",
  "main": "index.mjs",
  "compatibility_date": "2026-06-08",
  "workers_dev": false,
  "routes": [{ "pattern": "demo.datatug.app", "custom_domain": true }],
}
